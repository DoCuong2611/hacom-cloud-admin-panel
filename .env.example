# ============================================
# APP â€” shared defaults for all environments
# ============================================
# VITE_APP_ENV: development | staging | production | docker
VITE_APP_ENV=development
VITE_DASHBOARD_REFETCH_INTERVAL_MS=15000

# Write actions (lock/unlock users, approve requests, etc.)
# Set to false in dev/staging, true in production when ready
VITE_ADMIN_WRITE_ACTIONS_ENABLED=false

# IP Approval Feature Flag
# Set to true to enable IP approval feature, false to disable and show notice
VITE_ADMIN_IP_APPROVAL_ENABLED=true

# ============================================
# ADMIN API
# ============================================
# Canonical public auth base (used by authAxiosInstance)
VITE_AUTH_BASE_URL=/api/v1/auth
VITE_ACCESS_STATUS_POLL_MS=15000

# Compatibility alias for the Cloud public admin API root
VITE_ADMIN_API_BASE_URL=/api/v1/admin

# Canonical Cloud public admin API root (hacom-cloud-service)
VITE_ADMIN_API_ROOT=/api/v1/admin

# ============================================
# DEV PROXY (Vite dev server only)
# ============================================
# Only used by npm run dev to route /api/* to local backend services
# These do NOT get bundled â€” only read by Vite dev server at runtime
VITE_DEV_ADMIN_PROXY_TARGET=http://localhost:8080
# Preferred Cloud API proxy target; admin variable is a compatibility alias.
VITE_DEV_CLOUD_PROXY_TARGET=http://localhost:8080
VITE_DEV_AUTH_PROXY_TARGET=http://localhost:3101

# Cloud UI mode: live (default) or fixture (local UI-only testing).
VITE_CLOUD_API_MODE=live
# Local Vite demo only: bypasses Auth and grants a fake approved admin session.
# Never enable this in staging or production.
VITE_LOCAL_DEMO_AUTH=false

# ============================================
# WEBSOCKET
# ============================================
# For local dev with backend services
VITE_LIVE_UPDATES_URL=ws://localhost:8080/ws
VITE_WS_URL=ws://localhost:8080/ws
