# ============================================
# APP
# ============================================
# VITE_APP_ENV: development | staging | production | docker
VITE_APP_ENV=production
VITE_DASHBOARD_REFETCH_INTERVAL_MS=15000

# Write actions (lock/unlock users, approve requests, etc.)
# Set to false until admin panel is fully tested in production
VITE_ADMIN_WRITE_ACTIONS_ENABLED=false

# ============================================
# API BASE URLs
# ============================================
# Edge must route /api/v1/admin/* to hacom-cloud-service and /api/v1/auth/* to Auth.
# These get bundled into the app at build time
VITE_ADMIN_API_BASE_URL=/api/v1/admin
VITE_AUTH_BASE_URL=/api/v1/auth

# Canonical Cloud public admin API root
VITE_ADMIN_API_ROOT=/api/v1/admin


# ============================================
# WEBSOCKET
# ============================================
# Production WebSocket endpoint
VITE_LIVE_UPDATES_URL=wss://chat.hacomholdings.com.vn/ws
VITE_WS_URL=wss://chat.hacomholdings.com.vn/ws
